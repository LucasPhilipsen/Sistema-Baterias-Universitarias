# Copie para .env na raiz. Valores abaixo sao somente para desenvolvimento local.
PORT=3000
HOST=127.0.0.1
# O compose usa 5433 para nao conflitar com PostgreSQL instalado na maquina.
DATABASE_URL=postgresql://baterias:baterias_local@127.0.0.1:5433/baterias
POSTGRES_USER=baterias
POSTGRES_PASSWORD=baterias_local
POSTGRES_DB=baterias
POSTGRES_PORT=5433
